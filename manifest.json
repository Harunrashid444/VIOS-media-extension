{
  "manifest_version": 3,
  "name": "VIOS – Video & Timeline Accelerator",
  "version": "1.0.0",
  "description": "Synchronizes HTML5 media playbackRate with JavaScript timing APIs to uniformly accelerate e-learning courseware (Articulate Storyline, Adobe Captivate, etc.).",

  "minimum_chrome_version": "111",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_title": "VIOS – Video & Timeline Accelerator"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
