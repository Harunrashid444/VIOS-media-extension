dist/
build/
out/
*.crx
*.pem
*.zip


# ── Environment & secrets ─────────────────────
.env
.env.local
.env.*.local


# ── Logs ──────────────────────────────────────
logs/
*.log


# ── Test coverage ─────────────────────────────
coverage/
.nyc_output/


